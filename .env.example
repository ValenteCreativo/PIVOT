# demo | live | auto (auto chooses live only when Linkup and Nebius keys exist)
APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recursive web research
LINKUP_API_KEY=

# Structured mentor inference
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=zai-org/GLM-5.3-Flash

# Render Workflows. Use the registered task slug, e.g. pivot-analysis/run_analysis.
RENDER_API_KEY=
RENDER_WORKFLOW_ID=pivot-analysis/run_analysis
